[&"", &"Choose a source-defined pack before continuing."]: [&"Перед продолжением выберите набор по правилам."],
[&"", &"Starting equipment is ready. Choose a source-defined pack."]: [&"Начальное снаряжение готово. Выберите набор по правилам."],
[&"", &"Starting equipment Rolls are still pending."]: [&"Броски начального снаряжения ещё не завершены."],
[&"", &"Automatic Rolls complete. Continue to Origin & Traits."]: [&"Автоматические броски завершены. Перейдите к происхождению и чертам."],
[&"", &"Choose a class to begin."]: [&"Для начала выберите класс."],
[&"", &"The source Rolls are still pending."]: [&"Начальные броски ещё не завершены."],
[&"", &"Unknown Character action."]: [&"Неизвестное действие персонажа."],
[&"", &"Select this Creature’s source Rook before opening its attack."]: [&"Перед атакой выберите исходную фишку существа."],
[&"", &"Select this Character’s source Rook before opening its attack."]: [&"Перед атакой выберите исходную фишку персонажа."],
[&"", &"Enter whole numbers for difficulty and modifier."]: [&"Введите целые числа для сложности и модификатора."],
[&"", &"Character data is no longer available."]: [&"Данные персонажа больше недоступны."],
[&"", &"Character data is unavailable."]: [&"Данные персонажа недоступны."],
[&"", &"Appearance saved."]: [&"Внешность сохранена."],
[&"", &"Saving Character appearance…"]: [&"Сохранение внешности персонажа…"],
[&"", &"Saving this Rook’s appearance…"]: [&"Сохранение внешности фишки…"],
[&"", &"The selected Rook is no longer linked to this Character."]: [&"Выбранная фишка больше не связана с персонажем."],
[&"", &"Select this Character’s Rook first."]: [&"Сначала выберите фишку персонажа."],
[&"", &"Choose a published Miniature before saving."]: [&"Перед сохранением выберите опубликованную миниатюру."],
[&"", &"Wait for the current save, then retry."]: [&"Дождитесь сохранения и повторите попытку."],
[&"", &"Finish the current Throw before starting another action."]: [&"Завершите текущий бросок перед новым действием."],
[&"", &"Owner access is required to change this Character."]: [&"Для изменения персонажа нужны права владельца."],
[&"", &"DR10 · d6 · 5 ft. Enemy free attack on 1–2 on d6."]: [&"СЛ10 · d6 · 5 фт. При 1–2 на d6 враг получает свободную атаку."],
[&"", &"You can edit the sheet after creating the character."]: [&"После создания персонажа его лист можно редактировать."],
[&"", &"You can edit the completed sheet after creation."]: [&"После создания готовый лист можно редактировать."],
[&"", &"Choose from the packs available for your roll."]: [&"Выберите один из наборов, доступных по вашему броску."],
[&"", &"Continue with the next roll when ready."]: [&"Когда будете готовы, перейдите к следующему броску."],
[&"", &"Continue with the next ability when ready."]: [&"Когда будете готовы, перейдите к следующей характеристике."],
[&"", &"Rolls resolve in order. Dice are rolled automatically on your behalf."]: [&"Броски выполняются по порядку. Кости бросаются автоматически за вас."],
[&"", &"Your character is created after the final review."]: [&"Персонаж будет создан после итоговой проверки."],
[&"", &"You cannot read this scroll. Choose what to do with it."]: [&"Вы не можете прочитать этот свиток. Выберите, что с ним сделать."],
[&"", &"Waiting for the defending Player."]: [&"Ожидание защищающегося игрока."],
[&"", &"Waiting for the GM to authorize improvement."]: [&"Ожидание разрешения ведущего на развитие."],
[&"", &"View"]: [&"Просмотр"],
[&"", &"This item was removed. Return to Inventory to see the current items."]: [&"Предмет удалён. Вернитесь в инвентарь, чтобы увидеть текущие предметы."],
[&"", &"This attack always hits. Roll damage and protection."]: [&"Эта атака всегда попадает. Бросьте урон и защиту от урона."],
[&"", &"The table establishes that this rest has happened. Without food or drink, or while infected, resting restores no HP."]: [&"Группа подтверждает, что отдых состоялся. Без еды или питья, а также при инфекции отдых не восстанавливает ОЗ."],
[&"", &"The action was interrupted"]: [&"Действие прервано"],
[&"", &"Target is small or medium-sized"]: [&"Цель малого или среднего размера"],
[&"", &"Target is a faithless human (ordinary staff damage)"]: [&"Цель — неверующий человек (обычный урон посоха)"],
[&"", &"Spending reduces the count by one."]: [&"Трата уменьшает запас на один."],
[&"", &"Shown on the tabletop and in public reports."]: [&"Отображается на столе и в общедоступных отчётах."],
[&"", &"Seth, Goblin"]: [&"Сет, гоблин"],
[&"", &"Selected %s. Create a private Actor to edit its encounter sheet."]: [&"Выбрано: %s. Создайте скрытого актора, чтобы редактировать его боевой лист."],
[&"", &"Select this Character’s Rook"]: [&"Выберите фишку персонажа"],
[&"", &"Select a Rook and tap swords to add it."]: [&"Выберите фишку и нажмите мечи, чтобы добавить её."],
[&"", &"Save %s"]: [&"Сохранить: %s"],
[&"", &"Roll %s against DR%d. A failed defence lets the attack hit. Natural 20: free attack. Natural 1: double damage and armor loses one tier; its penalties remain."]: [&"Бросьте %s против СЛ%d. Провал защиты — попадание. Натуральная 20: свободная атака. Натуральная 1: двойной урон, броня теряет уровень, её штрафы остаются."],
[&"", &"Resolve the benefit with your group. Make resulting corrections through ordinary rolls and sheet editing."]: [&"Разрешите эффект вместе с группой. Внесите изменения обычными бросками и редактированием листа."],
[&"", &"Quick, attacks and defence are DR14."]: [&"Быстрый: атаки и защита имеют СЛ14."],
[&"", &"Public name shown to Players"]: [&"Имя, видимое игрокам"],
[&"", &"Public name pending"]: [&"Общедоступное имя ещё не задано"],
[&"", &"Private values · public name"]: [&"Скрытые значения · общедоступное имя"],
[&"", &"Private encounter equipment and attacks."]: [&"Скрытые снаряжение и атаки для сражения."],
[&"", &"Private Creature sheet · GM"]: [&"Скрытый лист существа · Ведущий"],
[&"", &"Preferred appearance for this Actor’s Rooks."]: [&"Предпочтительная внешность фишек этого актора."],
[&"", &"Preferred Miniature for this Actor’s Rooks."]: [&"Предпочтительная миниатюра для фишек этого актора."],
[&"", &"Players see the public name, not this sheet."]: [&"Игроки видят общедоступное имя; этот лист скрыт."],
[&"", &"Players see the chosen public name on the tabletop."]: [&"На столе игроки видят выбранное общедоступное имя."],
[&"", &"Only the public name appears to Players."]: [&"Игроки видят только общедоступное имя."],
[&"", &"Not dizzy; requirements met"]: [&"Нет головокружения; условия выполнены"],
[&"", &"Normal ability rolls and starting equipment."]: [&"Обычные броски характеристик и начальное снаряжение."],
[&"", &"No private attacks recorded."]: [&"Скрытые атаки не записаны."],
[&"", &"No matching equipment."]: [&"Снаряжение не найдено."],
[&"", &"No items yet. Add equipment from the core catalogue or create a custom item."]: [&"Предметов пока нет. Добавьте снаряжение из каталога или создайте своё."],
[&"", &"No granted Creature sheets are available to you."]: [&"Нет доступных листов полученных существ."],
[&"", &"No equipment equipped."]: [&"Ничего не надето."],
[&"", &"No core scrolls carried. Add a scroll from the Inventory catalogue."]: [&"Нет свитков основной книги. Добавьте свиток из каталога инвентаря."],
[&"", &"No class origin or traits."]: [&"Нет происхождения и черт класса."],
[&"", &"No ammunition available. Add it in Inventory."]: [&"Нет боеприпасов. Добавьте их в инвентарь."],
[&"", &"MÖRK BORG"]: [&"MÖRK BORG"],
[&"", &"Leave both unchecked to keep them."]: [&"Не отмечайте ни один, чтобы сохранить оба."],
[&"", &"Immutable definitions · private Actors"]: [&"Неизменяемые шаблоны · скрытые акторы"],
[&"", &"Hooded stranger"]: [&"Незнакомец в капюшоне"],
[&"", &"GM authorization received."]: [&"Разрешение ведущего получено."],
[&"", &"Full night’s sleep · d6 HP"]: [&"Полноценный сон · d6 ОЗ"],
[&"", &"Every morning: Presence + d4 uses. Confirm the morning with the table before rolling. Current uses can also be corrected in Edit Character."]: [&"Каждое утро: Присутствие + d4 применений. Подтвердите наступление утра с группой перед броском. Текущий запас можно изменить в редакторе персонажа."],
[&"", &"Enter a whole-number DR adjustment agreed with the table."]: [&"Введите целую поправку СЛ, согласованную с группой."],
[&"", &"Edit Toughness"]: [&"Изменить Стойкость"],
[&"", &"Edit Strength"]: [&"Изменить Силу"],
[&"", &"Edit Silver"]: [&"Изменить серебро"],
[&"", &"Edit SILVER"]: [&"Изменить серебро"],
[&"", &"Edit Presence"]: [&"Изменить Присутствие"],
[&"", &"Edit Omens"]: [&"Изменить знамения"],
[&"", &"Edit OMENS"]: [&"Изменить знамения"],
[&"", &"Edit HitPoints"]: [&"Изменить ОЗ"],
[&"", &"Edit HP"]: [&"Изменить ОЗ"],
[&"", &"Edit Agility"]: [&"Изменить Ловкость"],
[&"", &"Each creature has its own sheet. Place its Rook after creation."]: [&"У каждого существа свой лист. После создания разместите его фишку."],
[&"", &"Describe this Character"]: [&"Опишите персонажа"],
[&"", &"Create a private Creature sheet, then choose its public name."]: [&"Создайте скрытый лист существа и выберите общедоступное имя."],
[&"", &"Coward’s Jab (surprise, light one-handed)"]: [&"Трусливый выпад (внезапно, лёгким одноручным)"],
[&"", &"Continue to starting equipment."]: [&"Перейдите к начальному снаряжению."],
[&"", &"Confirm fictional requirements with the table, including a deceased target or death within a week where stated. Failure: lose d2 HP; dizziness is manual. Critical/fumble: GM decides. Armor and zweihand restrictions apply."]: [&"Подтвердите условия с группой, включая смерть цели и срок не более недели, если это указано. Провал: потеря d2 ОЗ; головокружение отслеживается вручную. Критический успех или провал решает ведущий. Учитывайте ограничения брони и двуручного оружия."],
[&"", &"Choose the scrolls with the table"]: [&"Выберите свитки с группой"],
[&"", &"Choose ability with the table (source unspecified)"]: [&"Выберите характеристику с группой (в правилах не указана)"],
[&"", &"Catch your breath · d4 HP"]: [&"Перевести дух · d4 ОЗ"],
[&"", &"Blank difficulty uses the source rule and armor. Agree situational changes with the table."]: [&"Пустая сложность — по правилам с учётом брони. Ситуативные изменения согласуйте с группой."],
[&"", &"Blank difficulty uses the Creature’s printed rule. Choose overrides with the table. Distance uses committed Rook centers."]: [&"Пустая сложность — по правилу существа. Изменения согласуйте с группой. Дистанция измеряется между центрами размещённых фишек."],
[&"", &"Begin after the GM grants an improvement. Resolve each step in order."]: [&"Начните после разрешения ведущего на развитие. Выполняйте шаги по порядку."],
[&"", &"Authorize improvement"]: [&"Разрешить развитие"],
[&"", &"At zero HP, roll Broken. Negative HP means dead. Delayed recovery and other timed consequences are handled by the table."]: [&"При 0 ОЗ бросьте увечье. Отрицательные ОЗ означают смерть. Отложенное восстановление и другие последствия во времени отслеживает группа."],
[&"", &"Appearance for the selected Rook."]: [&"Внешность выбранной фишки."],
[&"", &"Agreed DR adjustment (load / situation)"]: [&"Поправка СЛ (нагрузка / ситуация)"],
[&"", &"1 / 6 · CLASS"]: [&"1 / 6 · КЛАСС"],
[&"", &"%s  ·  Public: %s"]: [&"%s  ·  Общедоступное имя: %s"],
[&"", &"%s\n%s / %s HP"]: [&"%s\n%s / %s ОЗ"],
[&"", &" Check treachery when the table confirms continual disappointment; choose the possible victim before rolling. The source leaves check frequency and victim selection to the table."]: [&" Проверяйте предательство, когда группа подтверждает постоянное разочарование; выберите возможную жертву до броска. Частоту проверок и выбор жертвы определяет группа."],
[&"", &" Identity rollback failed: %s"]: [&" Не удалось восстановить имя: %s"],
[&"", &" Cleanup failed: %s"]: [&" Не удалось очистить: %s"],
[&"", &" Actor rollback failed: %s"]: [&" Не удалось отменить изменение актора: %s"],
