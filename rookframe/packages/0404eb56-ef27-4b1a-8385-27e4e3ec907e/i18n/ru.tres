[&"", &"%s attack"]: [&"Атака: %s"],
[&"", &"en"]: [&"ru"],
[&"", &"Shield broken; no damage taken."]: [&"Щит сломан; урона нет."],
[&"", &"Roll ended. Start a new roll or correct the current guidance."]: [&"Бросок завершён. Начните новый или исправьте текущие указания."],
[&"", &"Resistance failed. Throw the prescribed HP loss."]: [&"Сопротивление не удалось. Бросьте указанную потерю ОЗ."],
[&"", &"Throw damage for each bolt; allocation stays with the table."]: [&"Бросьте урон каждой молнии; распределяет группа."],
[&"", &"Throw d6+1 damage and protection."]: [&"Бросьте d6+1 урона и защиту от урона."],
[&"", &"Throw d4 rounds; ongoing consequences are manual."]: [&"Бросьте d4 раунда; длительные последствия отслеживаются вручную."],
[&"", &"Throw Presence DR8 for accuracy."]: [&"Бросьте Присутствие СЛ8 на точность."],
[&"", &"Throw today\'s Power allowance in the Dice Tray."]: [&"Бросьте дневной запас сил в лотке костей."],
[&"", &"Power activated. Throw its stated quantities in the Dice Tray."]: [&"Сила активирована. Бросьте указанные величины в лотке костей."],
[&"", &"This Creature\'s protection requires a table ruling."]: [&"Защита этого существа требует решения группы."],
[&"", &"This creature has no numeric Morale. Agree a Morale from 2 to 12 with the table."]: [&"У существа нет числового боевого духа. Согласуйте с группой значение от 2 до 12."],
[&"", &"This Creature has no numeric Morale. Resolve its printed rule with the table."]: [&"У существа нет числового боевого духа. Разрешите его правило с группой."],
[&"", &"This Rook\'s Actor is unavailable."]: [&"Актор этой фишки недоступен."],
[&"", &"Recipient data is unavailable."]: [&"Данные получателя недоступны."],
[&"", &"A targeted Creature is unavailable."]: [&"Выбранное существо недоступно."],
[&"", &"A targeted Actor is unavailable."]: [&"Выбранный актор недоступен."],
[&"", &"A target is unavailable."]: [&"Цель недоступна."],
[&"", &"The target is unavailable."]: [&"Цель недоступна."],
[&"", &"This weapon needs explicit attack rules. Choose a core ranged weapon from the catalogue."]: [&"Для этого оружия нужны явные правила атаки. Выберите дальнобойное оружие из основного каталога."],
[&"", &"Ability modifiers range from −3 to +6."]: [&"Модификаторы характеристик — от −3 до +6."],
[&"", &"Use a supported damage or reduction formula."]: [&"Используйте поддерживаемую формулу урона или его снижения."],
[&"", &"Only custom item mechanics can be changed."]: [&"Механику можно изменять только у своих предметов."],
[&"", &"This item is carried without an equipment state."]: [&"У этого предмета нет состояния «надет»."],
[&"", &"This item has no supported attack with an authored range."]: [&"У предмета нет поддерживаемой атаки с заданной дистанцией."],
[&"", &"This item field is not editable."]: [&"Это поле предмета нельзя редактировать."],
[&"", &"This Character field is unavailable. Reopen the sheet."]: [&"Поле персонажа недоступно. Откройте лист заново."],
[&"", &"This Character field is not editable."]: [&"Это поле персонажа нельзя редактировать."],
[&"", &"This item has been removed. Return to Inventory."]: [&"Предмет удалён. Вернитесь в инвентарь."],
[&"", &"Scrolls do not work while wielding zweihand weapons. Unequip the weapon first."]: [&"Свитки не работают с двуручным оружием в руках. Сначала уберите оружие."],
[&"", &"Scrolls do not work in medium/heavy armor. Only the Heretical Priest may cast in medium armor."]: [&"Свитки не работают в средней и тяжёлой броне. Только еретический жрец может применять силы в средней броне."],
[&"", &"The GM must be connected to resolve this target\'s test."]: [&"Для проверки этой цели ведущий должен быть подключён."],
[&"", &"The GM must be connected to defend this Actor."]: [&"Для защиты этого актора ведущий должен быть подключён."],
[&"", &"This Character’s Player is not connected."]: [&"Игрок этого персонажа не подключён."],
[&"", &"This Actor’s Player is not connected."]: [&"Игрок этого актора не подключён."],
[&"", &"Several Players own this Character. The responsible Player starts the action from their sheet."]: [&"У персонажа несколько игроков-владельцев. Ответственный игрок начинает действие из своего листа."],
[&"", &"Several Players own this Character. The responsible Player can roll from their sheet."]: [&"У персонажа несколько игроков-владельцев. Ответственный игрок может бросить из своего листа."],
[&"", &"Several Players own this Character. The responsible Player can attack from their sheet."]: [&"У персонажа несколько игроков-владельцев. Ответственный игрок может атаковать из своего листа."],
[&"", &"Round must be between 1 and 9999."]: [&"Номер раунда должен быть от 1 до 9999."],
[&"", &"Add Rooks before rolling initiative."]: [&"Добавьте фишки перед броском инициативы."],
[&"", &"Add Rooks before beginning combat."]: [&"Добавьте фишки перед началом боя."],
[&"", &"Select only Character or Creature witnesses."]: [&"Выберите свидетелями только персонажей или существ."],
[&"", &"Select one attack with an authored range."]: [&"Выберите атаку с заданной дистанцией."],
[&"", &"Select a linked Rook outside combat."]: [&"Выберите связанную фишку вне боя."],
[&"", &"Select a Rook in combat."]: [&"Выберите фишку в бою."],
[&"", &"Select a Character or Creature Rook."]: [&"Выберите фишку персонажа или существа."],
[&"", &"Select this Creature’s source Rook in the current Scene."]: [&"Выберите исходную фишку существа в текущей сцене."],
[&"", &"Select this Character’s source Rook in the current Scene."]: [&"Выберите исходную фишку персонажа в текущей сцене."],
[&"", &"Select this Character\'s source Rook."]: [&"Выберите исходную фишку персонажа."],
[&"", &"Select this Actor’s source Rook in the current Scene."]: [&"Выберите исходную фишку актора в текущей сцене."],
[&"", &"Owner access is required to use this Creature’s attack."]: [&"Для атаки существа нужны права его владельца."],
[&"", &"Owner access is required to use this Character."]: [&"Для этого действия нужны права владельца персонажа."],
[&"", &"Owner access is required to use this Character\'s equipment."]: [&"Для использования снаряжения нужны права владельца персонажа."],
[&"", &"Owner access is required to roll this Character."]: [&"Для броска нужны права владельца персонажа."],
[&"", &"Owner access is required to change this Actor."]: [&"Для изменения нужны права владельца актора."],
[&"", &"Owner access is required to cast from this Character."]: [&"Для применения сил нужны права владельца персонажа."],
[&"", &"Owner access is required to attack with this Actor."]: [&"Для атаки нужны права владельца актора."],
[&"", &"This Character already has an unused improvement authorization."]: [&"У персонажа уже есть неиспользованное разрешение на развитие."],
[&"", &"The GM must authorize this improvement first."]: [&"Сначала ведущий должен разрешить это развитие."],
[&"", &"Only the Occult Herbmaster can brew daily decoctions."]: [&"Только оккультный травник может варить ежедневные отвары."],
[&"", &"Only the GM manages encounter guidance."]: [&"Только ведущий управляет сражением."],
[&"", &"Only the GM can authorize improvement."]: [&"Только ведущий может разрешить развитие."],
[&"", &"No uses remain. Correct remaining uses on the item when the table agrees."]: [&"Применений не осталось. Исправьте запас предмета с согласия группы."],
[&"", &"No remaining supply. Correct the sheet when the table agrees."]: [&"Запас исчерпан. Исправьте лист с согласия группы."],
[&"", &"No daily Power uses remain. Establish today\'s allowance with the table."]: [&"Дневной запас сил исчерпан. Определите запас на сегодня с группой."],
[&"", &"No Omens remain."]: [&"Знамений не осталось."],
[&"", &"Choose the responsible Player for this Actor."]: [&"Выберите ответственного игрока для этого актора."],
[&"", &"This attack always hits. Waiting for damage and protection in the Dice Tray."]: [&"Эта атака всегда попадает. Ожидание урона и защиты от урона в лотке костей."],
[&"", &"The defending Player chooses Take damage or Break shield."]: [&"Защищающийся игрок выбирает: получить урон или сломать щит."],
[&"", &"The defending Player chooses and rolls their defence."]: [&"Защищающийся игрок выбирает и бросает защиту."],
[&"", &"Action ended. Completed rolls and changes remain. Resolve unfinished results with ordinary dice and sheet editing."]: [&"Действие завершено. Выполненные броски и изменения сохранены. Незавершённые результаты разрешите обычными бросками и редактированием листа."],
[&"", &"Complete the requested Throw in the Dice Tray."]: [&"Выполните запрошенный бросок в лотке костей."],
[&"", &"Waiting for the GM\'s Creature resistance Throw (DR14)."]: [&"Ожидание броска сопротивления существа ведущим (СЛ14)."],
[&"", &"Waiting for the recipient\'s shield decision."]: [&"Ожидание решения получателя о щите."],
[&"", &"Waiting for the casting Throw in the Dice Tray."]: [&"Ожидание проверки силы в лотке костей."],
[&"", &"Waiting for the attack Throw in the Dice Tray."]: [&"Ожидание броска атаки в лотке костей."],
[&"", &"Waiting for damage and protection in the Dice Tray."]: [&"Ожидание бросков урона и защиты от урона в лотке костей."],
[&"", &"Waiting for the defence Throw in the Dice Tray."]: [&"Ожидание броска защиты в лотке костей."],
[&"", &"Requesting the Throw…"]: [&"Запрос броска…"],
[&"", &"Requesting the action…"]: [&"Запрос действия…"],
[&"", &"Supporting decision copy"]: [&"Дополнительное пояснение"],
[&"", &"Field label"]: [&"Поле"],
[&"", &"Choice"]: [&"Выбор"],
[&"", &"%s / %s HP · %s"]: [&"%s / %s ОЗ · %s"],
[&"", &"Bow"]: [&"Лук"],
[&"", &"+%d on one roll (damage, tests etc.)."]: [&"+%d к одному броску (урон, проверка и т. п.)."],
[&"", &"%d extra HP for 10 rounds. Manage temporary HP manually; current and maximum HP are unchanged."]: [&"%d дополнительных ОЗ на 10 раундов. Временные ОЗ отслеживайте вручную; текущие и максимальные ОЗ не изменены."],
[&"", &"Blind for one hour; handle blindness manually."]: [&"Слепота на час; отслеживайте вручную."],
[&"", &"Two attacks per round, defence DR14 for one fight. Snort the snuff; sneezing and these benefits are handled manually."]: [&"Две атаки за раунд, защита СЛ14 на один бой. Вдохните порошок; чихание и эффекты отслеживаются вручную."],
[&"", &"Success: nearly invisible outside battle, with the mitre over your ears. Resolve the fictional change at the table."]: [&"Успех: вне боя почти невидимы, пока митра закрывает уши. Результат в мире разрешите с группой."],
[&"", &"Stealth failed."]: [&"Скрытность не удалась."],
[&"", &"Success with pockets and locks; resolve the fictional change at the table."]: [&"Успех с карманами и замками; результат в мире разрешите с группой."],
[&"", &"Failed to pick pockets or locks."]: [&"Не удалось обчистить карман или вскрыть замок."],
[&"", &"The stones may lie. Cannot test again until sunset; the table restores eligibility manually."]: [&"Камни могут лгать. Повторная проверка запрещена до заката; группа восстанавливает доступ вручную."],
[&"", &"The stones tell the truth about danger in the adjacent room. The table supplies the answer."]: [&"Камни говорят правду об опасности в соседней комнате. Ответ даёт группа."],
[&"", &"Strange light surrounds evil creatures. Defend with +2 against beings discovered this way; apply the benefit manually."]: [&"Злые существа окружены странным светом. Защита от обнаруженных так существ получает +2; примените эффект вручную."],
[&"", &"The horn grants no automatic success."]: [&"Рог не дарует автоматического успеха."],
[&"", &"The chosen creature\'s next non-combat test is an automatic success. Apply the benefit manually."]: [&"Следующая небоевая проверка выбранного существа — автоматический успех. Примените эффект вручную."],
[&"", &"The chosen creature\'s next test DR is lowered by 4. Apply this benefit manually."]: [&"СЛ следующей проверки выбранного существа снижена на 4. Примените эффект вручную."],
[&"", &"The right way remains unknown."]: [&"Верный путь остаётся неизвестен."],
[&"", &"You know the right way. The table describes it."]: [&"Вы знаете верный путь. Его описывает группа."],
[&"", &"No creatures are revealed."]: [&"Существа не обнаружены."],
[&"", &"Confused for 10 minutes."]: [&"Сбит с толку на 10 минут."],
[&"", &"Ask three questions to the deceased creature. Answers belong to the table."]: [&"Задайте умершему существу три вопроса. Ответы определяет группа."],
[&"", &"One creature blindly obeys a single command. Give and resolve the command at the table."]: [&"Одно существо слепо подчиняется одной команде. Отдайте и разрешите команду с группой."],
[&"", &"A creature dead for no more than a week is awakened with terrible memories. The source specifies no restored HP; make resurrection sheet changes manually."]: [&"Существо, умершее не более недели назад, оживает с ужасными воспоминаниями. Правила не указывают восстановленные ОЗ; изменения листа после воскрешения внесите вручную."],
[&"", &"Movement (tens of feet)"]: [&"Перемещение (десятки футов)"],
[&"", &"Shared HP loss"]: [&"Общая потеря ОЗ"],
[&"", &"Bolts (d2)"]: [&"Молнии (d2)"],
[&"", &"Creatures (d2)"]: [&"Существа (d2)"],
[&"", &"Bonus"]: [&"Бонус"],
[&"", &"Rounds + Presence"]: [&"Раунды + Присутствие"],
[&"", &"Rounds"]: [&"Раунды"],
[&"", &"Minutes"]: [&"Минуты"],
[&"", &"Extra HP"]: [&"Дополнительные ОЗ"],
[&"", &"Decoction"]: [&"Отвар"],
[&"", &"resistance; manual sleep / PC ability"]: [&"сопротивление; сон / характеристика персонажа вручную"],
[&"", &"manual temporary HP"]: [&"временные ОЗ вручную"],
[&"", &"manual restored HP"]: [&"восстановление ОЗ вручную"],
[&"", &"manual allocation"]: [&"распределение вручную"],
[&"", &"individual Creatures"]: [&"отдельные существа"],
[&"", &"immediate HP loss"]: [&"мгновенная потеря ОЗ"],
[&"", &"immediate healing"]: [&"мгновенное лечение"],
[&"", &"immediate damage"]: [&"мгновенный урон"],
[&"", &"One creature blindly obeys a single command"]: [&"Одно существо слепо подчиняется одной команде"],
[&"", &"d4 creatures lose d8 hp each"]: [&"d4 существа теряют по d8 ОЗ"],
[&"", &"You find all traps in your path for 2d10 minutes"]: [&"Вы находите все ловушки на пути в течение 2d10 минут"],
[&"", &"Light or pitch black for 3d10 minutes"]: [&"Свет или кромешная тьма на 3d10 минут"],
[&"", &"You may speak with animals for d20 minutes"]: [&"Вы можете говорить с животными d20 минут"],
[&"", &"One creature, dead for no more than a week, is awakened with terrible memories"]: [&"Существо, умершее не более недели назад, оживает с ужасными воспоминаниями"],
[&"", &"A creature of your choice gains 2d6 extra hp for 10 rounds"]: [&"Выбранное существо получает 2d6 дополнительных ОЗ на 10 раундов"],
[&"", &"Ask three questions to a deceased creature"]: [&"Задайте три вопроса умершему существу"],
[&"", &"A creature of your choice gets +d6 on one roll (damage, tests etc.)"]: [&"Выбранное существо получает +d6 к одному броску (урон, проверка и т. п.)"],
[&"", &"d2 creatures regain d10 hp each"]: [&"d2 существа восстанавливают по d10 ОЗ"],
[&"", &"All creatures within 30 feet lose a total of 4d10 hp"]: [&"Все существа в пределах 30 футов теряют суммарно 4d10 ОЗ"],
[&"", &"d4 creatures fall asleep for one hour unless they succeed a dr14 test"]: [&"d4 существа засыпают на час, если не пройдут проверку СЛ14"],
[&"", &"Summon (d6): 1–3 d4 skeletons 4–6 d4 zombies"]: [&"Призовите (d6): 1–3 — d4 скелета, 4–6 — d4 зомби"],
[&"", &"A creature becomes invisible for d6 rounds or until it is damaged, attacking/defending with dr6"]: [&"Существо невидимо d6 раундов или до получения урона; атака и защита СЛ6"],
[&"", &"Produce d2 lightning bolts dealing d6 damage each"]: [&"Создайте d2 молнии, каждая наносит d6 урона"],
[&"", &"One creature suffocates for d6 rounds, losing d4 hp per round"]: [&"Одно существо задыхается d6 раундов, теряя d4 ОЗ за раунд"],
[&"", &"Hover for Presence + d10 rounds"]: [&"Парите в течение Присутствие + d10 раундов"],
[&"", &"Move an object up to d10×10 feet for d6 minutes"]: [&"Перемещайте предмет на расстояние до d10×10 футов в течение d6 минут"],
[&"", &"A creature of your choice is confused for 10 minutes"]: [&"Выбранное существо сбито с толку на 10 минут"],
[&"", &"A ball of fire hits d2 creatures dealing d8 damage per creature"]: [&"Огненный шар поражает d2 существа, нанося каждому d8 урона"],
[&"", &"Enochian syntax"]: [&"Енохианский синтаксис"],
[&"", &"Roskoe\'s consuming glare"]: [&"Пожирающий взгляд Роско"],
[&"", &"Hermetic step"]: [&"Герметический шаг"],
[&"", &"False dawn/night\'s chariot"]: [&"Ложный рассвет / колесница ночи"],
[&"", &"Bestial speech"]: [&"Звериная речь"],
[&"", &"Unmet fate"]: [&"Несбывшаяся судьба"],
[&"", &"Aegis of sorrow"]: [&"Эгида скорби"],
[&"", &"Whispers pass the gate"]: [&"Шёпот проходит сквозь врата"],
[&"", &"Grace for a sinner"]: [&"Милость грешнику"],
[&"", &"Grace of a dead saint"]: [&"Милость мёртвого святого"],
[&"", &"Death"]: [&"Смерть"],
[&"", &"Eyelid blinds the mind"]: [&"Веко ослепляет разум"],
[&"", &"Foul psychompomp"]: [&"Мерзкий психопомп"],
[&"", &"Metzhuotl blind your eye"]: [&"Мецуотль, ослепи твой глаз"],
[&"", &"Nine violet signs unknot the storm"]: [&"Девять фиолетовых знаков развязывают бурю"],
[&"", &"Daemon of capillaries"]: [&"Демон капилляров"],
[&"", &"Lucy-fires levitation"]: [&"Левитация Люци-огня"],
[&"", &"Te-le-kin-esis"]: [&"Те-ле-ки-нез"],
[&"", &"Tongue of eris"]: [&"Язык Эриды"],
[&"", &"Palms open the southern gate"]: [&"Ладони открывают южные врата"],
[&"", &" Natural-weapon fumbles are adjudicated by the GM."]: [&" Критические провалы естественного оружия разрешает ведущий."],
[&"", &"Shared doses for the two generated decoctions. Allocate at the table; unused decoctions lose vitality after 24 hours. Track eligibility and expiry manually."]: [&"Общий запас двух созданных отваров. Распределите с группой; неиспользованные отвары теряют силу через 24 часа. Условия и сроки отслеживайте вручную."],
[&"", &"Vomit for d4 hours. Pass a DR14 test or do nothing else. The source does not select an ability; the table adjudicates it and tracks the effect."]: [&"Рвота d4 часа. Пройдите проверку СЛ14, иначе больше ничего не можете делать. Характеристика не указана; группа выбирает её и отслеживает эффект."],
[&"", &"Snort to go berserk: two attacks per round, defence DR14 for one fight. Causes sneezing. Track the effects manually."]: [&"Вдохните, чтобы впасть в ярость: две атаки за раунд, защита СЛ14 на один бой. Вызывает чихание. Эффекты отслеживайте вручную."],
[&"", &"See in darkness and climb walls for 30 minutes. Handle these benefits manually."]: [&"Видите в темноте и лазаете по стенам 30 минут. Эффекты применяйте вручную."],
[&"", &"See in darkness and climb on walls for 30 minutes. Track the effects manually."]: [&"Видите в темноте и лазаете по стенам 30 минут. Эффекты отслеживайте вручную."],
[&"", &"Pass a DR14 test or suffer severe hallucinations for d4 hours. The source does not select an ability; the table adjudicates it and tracks the effect."]: [&"Пройдите проверку СЛ14 или страдайте тяжёлыми галлюцинациями d4 часа. Характеристика не указана в правилах; группа выбирает её и отслеживает эффект."],
[&"", &"Toughness DR12 or lose d10 HP."]: [&"Стойкость СЛ12 или потеря d10 ОЗ."],
[&"", &"Toughness DR14 or lose d6 HP and become blind for one hour. Track blindness manually."]: [&"Стойкость СЛ14 или потеря d6 ОЗ и слепота на час. Слепоту отслеживайте вручную."],
[&"", &"Dab the translucent oil into the eye: cures infection and gives +2 on Presence tests for d4 hours. Track the benefit manually."]: [&"Капните прозрачное масло в глаз: устраняет инфекцию и даёт +2 к проверкам Присутствия на d4 часа. Эффект отслеживайте вручную."],
[&"", &"Heals d6 HP and stops infection. May be habit-forming."]: [&"Лечит d6 ОЗ и устраняет инфекцию. Может вызывать привыкание."],
[&"", &"Against undead, lesser trolls and goblins, check Morale, adding or subtracting the Priest’s Presence modifier, to see whether they bow and leave."]: [&"Против нежити, низших троллей и гоблинов проверьте боевой дух, прибавив или вычтя модификатор Присутствия жреца: склонятся ли они и уйдут."],
[&"", &"Cast the stones to reveal danger in an adjacent room. The stones may lie: test Presence DR10 for truth; after failure, cannot test again until sunset. Track the restriction manually."]: [&"Бросьте камни, чтобы выявить опасность в соседней комнате. Камни могут лгать: Присутствие СЛ10 для правды; после провала повторять нельзя до заката. Ограничение отслеживайте вручную."],
[&"", &"Read once per day and roll a die. Even: PCs heal d4 HP after five minutes of rest for the rest of the day. Odd: the GM invents d3 hallucinations only the Priest sees until sunrise. Resolve effects and duration manually."]: [&"Читайте раз в день и бросьте кость. Чётное: до конца дня персонажи лечат d4 ОЗ после пяти минут отдыха. Нечётное: ведущий придумывает d3 галлюцинации, видимые лишь жрецу до рассвета. Эффекты и длительность отслеживайте вручную."],
[&"", &"Presence DR10 reveals evil creatures in strange light. The owner defends with +2 against beings discovered this way. Track the benefit manually."]: [&"Присутствие СЛ10 окружает злых существ странным светом. Владелец защищается с +2 от обнаруженных так существ. Эффект отслеживайте вручную."],
[&"", &"While worn, defence DR10. Pulled over the ears outside battle, nearly invisible: stealth DR8."]: [&"Пока надета, защита СЛ10. Вне боя, натянутая на уши, делает почти невидимым: скрытность СЛ8."],
[&"", &"A human-bone crook inscribed with anti-prayers that hooks through other worlds. Staff deals 2d4 damage except to faithless humans."]: [&"Посох из человеческих костей с антимолитвами, цепляющий иные миры. Наносит 2d4 урона, кроме атак по неверующим людям."],
[&"", &"Once per day, sound the horn and test Presence DR12. One creature may make its next non-combat test an automatic success. Track the benefit manually."]: [&"Раз в день протрубите в рог и проверьте Присутствие СЛ12. Следующая небоевая проверка одного существа может стать автоматическим успехом. Эффект отслеживайте вручную."],
[&"", &"A poisoned dagger in a silk-lined, snakeskin-bound sandalwood box. d4 damage; on a damage roll of 1, deadly poison kills the target immediately."]: [&"Отравленный кинжал в сандаловой шкатулке, обтянутой змеиной кожей и выстланной шёлком. d4 урона; при 1 на кости урона яд мгновенно убивает цель."],
[&"", &"Cowardly guardian of the cursed sword Eurekia. Once per combat, if Hamfund can be found, draw Eurekia: 2d6 damage. Roll d6 for each swing; on 1 Hamfund dies and Eurekia vanishes forever. Track this at the table."]: [&"Трусливый хранитель проклятого меча Эврекия. Раз за бой, если найдёте Хамфунда, достаньте Эврекию: 2d6 урона. Бросайте d6 за каждый взмах; при 1 Хамфунд умирает, а Эврекия исчезает навсегда. Отслеживайте с группой."],
[&"", &"A magical, intelligent, arrogant talking horse. If persuaded to care, occasionally adds +2 to Presence tests involving logic and intellect. The table adjudicates the benefit."]: [&"Волшебный, умный и надменный говорящий конь. Если его заинтересовать, иногда даёт +2 к проверкам Присутствия на логику и интеллект. Эффект определяет группа."],
[&"", &"For the first two combat rounds, you and your allies gain +2 on attack/defence. Track the benefit manually."]: [&"В первые два раунда боя вы и союзники получаете +2 к атаке/защите. Эффект отслеживайте вручную."],
[&"", &"A magical talking sword, foppish and unreliable. Attack/defence DR10, d6+1 damage. If continually disappointed, it develops a 1-in-6 chance to attack you or your companions; the table adjudicates this."]: [&"Волшебный говорящий меч, щеголеватый и ненадёжный. Атака/защита СЛ10, d6+1 урона. Если его постоянно разочаровывать, появляется шанс 1 из 6 атаковать вас или спутников; решает группа."],
[&"", &"Loyal only to its Hermit, who understands its cries. Keeps watch, scouts and attacks."]: [&"Верен только своему отшельнику, понимающему его крики. Наблюдает, разведывает и нападает."],
[&"", &"A crafty, almost-intelligent hawk is loyal only to you. You understand its cries as it watches, scouts and attacks. Attack and defence DR10; claws/bite d4; HP 8."]: [&"Хитрый, почти разумный ястреб верен только вам. Вы понимаете его крики, когда он наблюдает, разведывает и нападает. Атака и защита СЛ10; когти/укус d4; 8 ОЗ."],
[&"", &"Music from your harp gives +d4 on reaction rolls."]: [&"Музыка вашей арфы даёт +d4 к броскам реакции."],
[&"", &"Once per day summon d2 scrolls, each usable once. Roll d4: 1–2 sacred, 3–4 unclean. Unused scrolls turn to ash at sunrise. Resolve summons and track uses and expiry manually."]: [&"Раз в день призовите d2 одноразовых свитка. Бросьте d4: 1–2 — священные, 3–4 — нечистые. Неиспользованные свитки обращаются в пепел на рассвете. Призыв, применения и срок отслеживайте вручную."],
[&"", &"Twice per day, lower the DR of a chosen creature’s next test by 4. Track uses and the benefit manually."]: [&"Дважды в день снизьте СЛ следующей проверки выбранного существа на 4. Применения и эффект отслеживайте вручную."],
[&"", &"Read once per day. An enemy tests DR12 to prevent it; on failure, d2 Berserker-slayers appear. Roll d6: 1–4 they fight alongside you; 5–6 they try to kill you and destroy the book. They return to imprisonment after battle. Resolve the summons and duration at the table."]: [&"Читайте раз в день. Враг проверяет СЛ12, чтобы помешать; при провале появляются d2 берсерка-убийцы. Бросьте d6: 1–4 — сражаются за вас; 5–6 — пытаются убить вас и уничтожить книгу. После боя возвращаются в заточение. Призыв и длительность разрешайте с группой."],
[&"", &"Know the right way with a Presence DR8 test."]: [&"Узнайте верный путь проверкой Присутствия СЛ8."],
[&"", &"The ruins of the Shadow King’s manse, thick with memories."]: [&"Руины поместья Теневого короля, пропитанные воспоминаниями."],
[&"", &"The old frozen ruins not far from Alliáns."]: [&"Старые замёрзшие руины неподалёку от Альянса."],
[&"", &"The illegal midnight markets of Schleswig."]: [&"Нелегальные полуночные рынки Шлезвига."],
[&"", &"The heretic isle of Crëlut, two nautical miles east of Grift."]: [&"Еретический остров Крэлут, две морские мили к востоку от Грифта."],
[&"", &"Awakening, adult, in a ritual circle underneath the northern bridge to Grift."]: [&"Вы очнулись уже взрослым в ритуальном круге под северным мостом в Грифт."],
[&"", &"A little witches cottage in Galgenbeck."]: [&"Маленькая ведьмина хижина в Гальгенбеке."],
[&"", &"Secret Bergen Chrypt church."]: [&"Тайная церковь Берген-Крипта."],
[&"", &"One of the many Graven-Tosk thief-tunnels."]: [&"Один из многочисленных воровских туннелей Гравен-Тоска."],
[&"", &"Temple ruins in the Valley of the Unfortunate Undead."]: [&"Руины храма в Долине несчастной нежити."],
[&"", &"The crypts of Grift."]: [&"Склепы Грифта."],
[&"", &"Massacred Alliáns cult, sole survivor."]: [&"Единственный выживший после резни культа в Альянсе."],
[&"", &"Galgenbeck, near the cathedral of the Two-Headed Basilisks."]: [&"Гальгенбек, возле собора Двуглавых Василисков."],
[&"", &"Two young princes were kidnapped west of Bergen Chrypt."]: [&"Двух юных принцев похитили к западу от Берген-Крипта."],
[&"", &"Anthelia demanded a gift of noble blood."]: [&"Антелия потребовала дар благородной крови."],
[&"", &"The southern empire of Südglans sank into the sea."]: [&"Южная империя Зюдгланс погрузилась в море."],
[&"", &"King Fathmu IX’s brother Zigmund, your father, was murdered."]: [&"Ваш отец Зигмунд, брат короля Фатму IX, был убит."],
[&"", &"Your caravan kingdom of Tveland fell into penury."]: [&"Ваше караванное королевство Твеланда впало в нищету."],
[&"", &"Your Wästland palace was reduced to rubble."]: [&"Ваш дворец в Вестланде превратили в руины."],
[&"", &"Raised on a lonely island in Lake Onda; no one else has heard of it and you cannot return."]: [&"Вы выросли на одиноком острове озера Онда; никто о нём не слышал, и вернуться вы не можете."],
[&"", &"Wandered, memoryless, from the mouth of a cavern at the cliffs of Terion."]: [&"Вы вышли без памяти из пещеры в скалах Териона."],
[&"", &"Single child survivor of an incident in the Valley of the Unfortunate Undead."]: [&"Единственный выживший ребёнок после происшествия в Долине несчастной нежити."],
[&"", &"Dying of plague in a Bergen Chrypt hovel, you touched something from outside."]: [&"Умирая от чумы в лачуге Берген-Крипта, вы коснулись чего-то извне."],
[&"", &"Calm isolation in the Sarkash dark."]: [&"Спокойное одиночество во тьме Саркаша."],
[&"", &"An average individual until you encountered something in a dim glade in Sarkash."]: [&"Вы были обычным человеком, пока не встретили нечто на сумрачной поляне Саркаша."],
[&"", &"Carry a portable laboratory. Daily materials allow two random decoctions and a total of d4 doses. Unused decoctions lose vitality after 24 hours; track eligibility and expiry manually."]: [&"Носит переносную лабораторию. Ежедневные материалы дают два случайных отвара и общий запас d4 доз. Неиспользованные отвары теряют силу через 24 часа; условия и сроки отслеживайте вручную."],
[&"", &"May use Powers while wearing medium armor."]: [&"Может применять силы в средней броне."],
[&"", &"Tough as wood: Toughness 3d6+2. Low in protein: Strength 3d6−2."]: [&"Крепкий как дерево: Стойкость 3d6+2. Недостаток белка: Сила 3d6−2."],
[&"", &"Begin with two independently rolled gifts."]: [&"Начните с двумя дарами, брошенными независимо."],
[&"", &"Painfully average: no ability adjustments. Roll d8 for weapons and d4 for armor; reroll heavy armor."]: [&"Болезненно заурядный: без поправок характеристик. Бросьте d8 для оружия и d4 для брони; тяжёлую броню перебросьте."],
[&"", &"Begin with ordinary equipment plus one random sacred or unclean scroll."]: [&"Начните с обычным снаряжением и одним случайным священным или нечистым свитком."],
[&"", &"Insightful: Presence 3d6+2. Frail: Strength 3d6−2. Roll d8 for weapons."]: [&"Проницательный: Присутствие 3d6+2. Хилый: Сила 3d6−2. Бросьте d8 для оружия."],
[&"", &"On death, if survival is at all possible, there is a 50% chance you survived. After 10 rounds return with d4 HP and an unlikely explanation. Resolve and track this manually."]: [&"При смерти, если выживание вообще возможно, вы выживаете с вероятностью 50%. Через 10 раундов возвращаетесь с d4 ОЗ и неправдоподобным объяснением. Разрешайте и отслеживайте вручную."],
[&"", &"When hidden in muck, debris and filth, noticing you requires Presence DR16. Resolve observers\' tests manually."]: [&"Чтобы заметить вас среди грязи, мусора и нечистот, нужна проверка Присутствия СЛ16. Проверки наблюдателей проводите вручную."],
[&"", &"When hidden in muck, debris and filth, noticing you requires Presence DR16."]: [&"Чтобы заметить вас среди грязи, мусора и нечистот, нужна проверка Присутствия СЛ16."],
[&"", &"Each Omen use has a 50% chance not to spend it. Resolve the chance and Omen benefit manually, using ordinary dice and sheet corrections. No Omen benefit is automated."]: [&"Каждое применение знамения с вероятностью 50% не тратит его. Разрешайте шанс и эффект вручную обычными бросками и правками листа. Эффекты знамений не автоматизированы."],
[&"", &"Each Omen use has a 50% chance not to spend it. Resolve and track this benefit manually."]: [&"Каждое применение знамения с вероятностью 50% не тратит его. Эффект разрешайте и отслеживайте вручную."],
[&"", &"Spit d2 times per fight at short range with Presence DR8. Targets are blinded, retching and vomiting for d4 rounds. Witnesses test Toughness to avoid vomiting: PCs DR10, enemies DR12. Track effects and rounds manually."]: [&"Плюйте d2 раза за бой на близкую дистанцию, Присутствие СЛ8. Цели ослеплены, давятся и блюют d4 раунда. Свидетели проверяют Стойкость против рвоты: персонажи СЛ10, враги СЛ12. Эффекты и раунды отслеживайте вручную."],
[&"", &"Pick pockets and locks with an Agility DR8 test. Begin with lockpicks."]: [&"Очищайте карманы и вскрывайте замки проверкой Ловкости СЛ8. Начинаете с отмычками."],
[&"", &"When attacking by surprise, test Agility DR10. Success automatically hits once with a light one-handed weapon for normal damage +3."]: [&"При внезапной атаке проверьте Ловкость СЛ10. Успех — одно автоматическое попадание лёгким одноручным оружием с обычным уроном +3."],
[&"", &"Educated by outlaws in a hovel south of Alliáns."]: [&"Вас учили разбойники в лачуге к югу от Альянса."],
[&"", &"Escaped the Tvelandian orphanarium."]: [&"Вы сбежали из твеландского сиротского приюта."],
[&"", &"Kicked and beaten beneath a baker’s table in Schleswig."]: [&"Вас пинали и били под столом пекаря в Шлезвиге."],
[&"", &"Raised by rats in the gutters of Grift."]: [&"Вас вырастили крысы в канавах Грифта."],
[&"", &"Mother hanged from a tree outside Galgenbeck; you fell from the corpse."]: [&"Мать повесили на дереве за Гальгенбеком; вы выпали из трупа."],
[&"", &"Dumped onto a moving shit-cart still in your birth caul."]: [&"Вас выбросили в едущую телегу с дерьмом, ещё в родовой оболочке."],
[&"", &"On first getting better, roll another specialty. From the second improvement, you may reroll either or both specialties; resolve improvements at the table."]: [&"При первом развитии бросьте ещё один талант. Начиная со второго можно перебросить один или оба таланта; развитие разрешайте с группой."],
[&"", &"All Presence and Agility tests have their DR reduced by 2 (normal tests DR10)."]: [&"СЛ всех проверок Присутствия и Ловкости снижена на 2 (обычные проверки СЛ10)."],
[&"", &"Attack DR10, d4 damage. A 1-in-6 chance instantly kills small-to-medium creatures. Returns to the wielder."]: [&"Атака СЛ10, d4 урона. Шанс 1 из 6 мгновенно убить существо малого или среднего размера. Возвращается к владельцу."],
[&"", &"Sniffs out treasure in debris. Frenzied around goblins and berserkers."]: [&"Вынюхивает сокровища среди обломков. Впадает в ярость рядом с гоблинами и берсерками."],
[&"", &"Sniffs out treasure in debris. Bite d6, attack DR10, defence DR12, HP 10. Frenzied around goblins and berserkers."]: [&"Вынюхивает сокровища среди обломков. Укус d6, атака СЛ10, защита СЛ12, 10 ОЗ. Впадает в ярость рядом с гоблинами и берсерками."],
[&"", &"2d4 damage; uses fist-sized rocks."]: [&"2d4 урона; использует камни размером с кулак."],
[&"", &"Four teeth. Before battle roll d6 for each; each 6 makes one attack deal maximum damage. The table tracks these benefits."]: [&"Четыре зуба. Перед боем бросьте d6 за каждый; каждая 6 даёт максимальный урон одной атаки. Эффекты отслеживает группа."],
[&"", &"d6 damage; attack and defence DR10 while wielded. A wounded enemy has a 1-in-6 chance of sepsis and death in 10 minutes; track that consequence manually."]: [&"d6 урона; атака и защита СЛ10, пока оружие в руках. У раненого врага шанс 1 из 6 получить сепсис и умереть через 10 минут; последствие отслеживайте вручную."],
[&"", &"While worn, lesser creatures such as goblins, gnoums and children check Morale every round. Resolve these ongoing checks manually."]: [&"Пока маска надета, низшие существа — гоблины, гнумы и дети — проверяют боевой дух каждый раунд. Эти проверки проводите вручную."],
[&"", &"While worn, lesser creatures such as goblins, gnoums and children check Morale every round. Resolve ongoing effects manually."]: [&"Пока маска надета, низшие существа — гоблины, гнумы и дети — проверяют боевой дух каждый раунд. Длительные эффекты отслеживайте вручную."],
[&"", &"Suckling a wolf in the wild of Bergen Chrypt."]: [&"Вас выкормила волчица в дебрях Берген-Крипта."],
[&"", &"Following an army in eastern Wästland."]: [&"Вы следовали за армией на востоке Вестланда."],
[&"", &"Sleeping with dogs in the corner of an inn, waiting for someone to return."]: [&"Вы спали с собаками в углу трактира, ожидая чьего-то возвращения."],
[&"", &"A brothel in Schleswig. Quite a friendly environment."]: [&"Бордель в Шлезвиге. Довольно дружелюбное место."],
[&"", &"A derelict rotting ship rolling endlessly across a grey sea."]: [&"Заброшенный гниющий корабль, бесконечно качающийся в сером море."],
[&"", &"A burnt-black building in Sarkash. Your home?"]: [&"Обугленное здание в Саркаше. Ваш дом?"],
[&"", &"Illiterate: cannot understand scrolls. Reroll starting scroll equipment, eat it, or use it as toilet paper."]: [&"Неграмотен: не понимает свитки. Перебросьте начальный свиток, съешьте его или используйте как туалетную бумагу."],
[&"", &"Normal Agility tests are DR14; defence is excluded."]: [&"Обычные проверки Ловкости имеют СЛ14; защита — исключение."],
[&"", &"Bite: DR10, d6 damage at close range. On 1–2 on d6 the enemy gains a free attack."]: [&"Укус: СЛ10, d6 урона вблизи. При 1–2 на d6 враг получает свободную атаку."],
[&"", &"Portable laboratory"]: [&"Переносная лаборатория"],
[&"", &"Wrong Jesus crucifix"]: [&"Распятие неправильного Иисуса"],
[&"", &"Wizard teeth"]: [&"Зубы волшебника"],
[&"", &"The snake-skin gift"]: [&"Дар в змеиной коже"],
[&"", &"The shoe of Death’s horse"]: [&"Подкова коня Смерти"],
[&"", &"The brown scimitar of Galgenbeck"]: [&"Бурый скимитар Гальгенбека"],
[&"", &"The blasphemous Nechrubel Bible"]: [&"Богохульная Библия Нехрубеля"],
[&"", &"The blade of your ancestors"]: [&"Клинок ваших предков"],
[&"", &"Stones taken from Thel-Emas’ lost temple"]: [&"Камни из утраченного храма Тель-Эмаса"],
[&"", &"Stolen mitre"]: [&"Краденая митра"],
[&"", &"Spider-owl soup"]: [&"Суп из паукосовы"],
[&"", &"Speaker of truths"]: [&"Глашатай истин"],
[&"", &"Southern frog stew"]: [&"Южная лягушачья похлёбка"],
[&"", &"Sacred shepherd’s crook"]: [&"Священный пастуший посох"],
[&"", &"Poltroon the court jester"]: [&"Придворный шут Полтрун"],
[&"", &"Old Sigûrd’s sling"]: [&"Праща старого Сигурда"],
[&"", &"Master of fate"]: [&"Властелин судьбы"],
[&"", &"Initiate of the Invisible College"]: [&"Посвящённый Незримой коллегии"],
[&"", &"Hyphos’ enervating snuff"]: [&"Изнуряющий нюхательный порошок Гифоса"],
[&"", &"Horn of the Schleswig lords"]: [&"Рог лордов Шлезвига"],
[&"", &"Hawk as weapon"]: [&"Ястреб как оружие"],
[&"", &"Hamfund the squire"]: [&"Оруженосец Хамфунд"],
[&"", &"Filthy fingersmith"]: [&"Грязный карманник"],
[&"", &"Fernor’s philtre"]: [&"Зелье Фернора"],
[&"", &"Ezumiel’s vapor"]: [&"Пар Эзумиэля"],
[&"", &"Excretal stealth"]: [&"Навозная скрытность"],
[&"", &"Eurekia"]: [&"Эврекия"],
[&"", &"Escaping fate"]: [&"Бегство от судьбы"],
[&"", &"Elixir vitalis"]: [&"Эликсир виталис"],
[&"", &"Dodging death"]: [&"Ускользающий от смерти"],
[&"", &"Crumpled monster mask"]: [&"Мятая маска чудовища"],
[&"", &"Coward’s jab"]: [&"Трусливый выпад"],
[&"", &"Book of boiling blood"]: [&"Книга кипящей крови"],
[&"", &"Bard of the Undying"]: [&"Бард неумирающих"],
[&"", &"Barbarister the incredible horse"]: [&"Барбаристер, невероятный конь"],
[&"", &"Abominable gob lobber"]: [&"Омерзительный плевун"],
[&"", &"Barrier (necro)"]: [&"Преграда (некро)"],
[&"", &"Creature type"]: [&"Тип существа"],
[&"", &"Used on 1–2 on a d6 each round. Always hits."]: [&"Применяется при 1–2 на d6 каждый раунд. Всегда попадает."],
[&"", &"Toughness DR14 avoids one painful hour of paralysis; duration is table managed."]: [&"Стойкость СЛ14 позволяет избежать часа болезненного паралича; длительность отслеживает группа."],
[&"", &"Moves silently and attacks by surprise. Can repeat voices it has heard. Piercing attacks against it are DR14. Any strike dealing 5 or more damage destroys it completely."]: [&"Движется бесшумно и нападает внезапно. Повторяет услышанные голоса. Колющие атаки против него имеют СЛ14. Любой удар на 5+ урона полностью его уничтожает."],
[&"", &"On a bite, Toughness DR8 or death within two days followed by rising as a zombie. Delayed consequences are table managed."]: [&"При укусе — Стойкость СЛ8 или смерть в течение двух дней и восстание зомби. Отложенные последствия отслеживает группа."],
[&"", &"Infection on 1 in 6"]: [&"Инфекция при 1 на d6"],
[&"", &"60% chance of biting; otherwise use Sting."]: [&"60% вероятности укуса; иначе использует жало."],
[&"", &"d6+2 hp, bite d4, only obeys you"]: [&"d6+2 ОЗ, укус d4, слушается только вас"],
[&"", &"d4 monkeys that ignore but love you (d4+2 hp, punch/bite d4)"]: [&"d4 обезьяны, которые любят, но игнорируют вас (d4+2 ОЗ, удар/укус d4)"],
[&"", &"Toughness dr14 or d6 damage + blind for one hour\n3 doses"]: [&"Стойкость СЛ14 или d6 урона и слепота на час\n3 дозы"],
[&"", &"Toughness dr12 or d10 damage\n3 doses\nStarting equipment supplies a bottle with d4 doses"]: [&"Стойкость СЛ12 или d10 урона\n3 дозы\nВ начальном снаряжении бутылка с d4 дозами"],
[&"", &"d4 doses\nHeals d6 hp and removes infection"]: [&"d4 дозы\nЛечит d6 ОЗ и устраняет инфекцию"],
[&"", &"Stops bleeding/infection and heals d6 hp\nPresence + 4 uses"]: [&"Останавливает кровотечение и инфекцию, лечит d6 ОЗ\nПрисутствие + 4 применения"],
[&"", &"−1 damage\n-1 hp damage or have the shield break to ignore one attack"]: [&"−1 урон\nСнизить урон на 1 ОЗ или сломать щит, чтобы избежать одной атаки"],
[&"", &"splint, plate etc\n−d6 damage, tier 3"]: [&"Шинная броня, латы и т. п.\n−d6 урона, уровень 3"],
[&"", &"scale, mail etc\n−d4 damage, tier 2"]: [&"Чешуя, кольчуга и т. п.\n−d4 урона, уровень 2"],
[&"", &"fur, padded cloth, leather etc\n−d2 damage, tier 1"]: [&"Мех, стёганая ткань, кожа и т. п.\n−d2 урона, уровень 1"],
[&"", &"worth roughly 50s to the right buyer"]: [&"стоит около 50 серебра подходящему покупателю"],
[&"", &"with Presence +10 arrows"]: [&"с Присутствием + 10 стрелами"],
[&"", &"with Presence + 10 bolts"]: [&"с Присутствием + 10 болтами"],
[&"", &"not bad"]: [&"неплохо"],
[&"", &"Presence dr14 to spot"]: [&"Присутствие СЛ14, чтобы заметить"],
[&"", &"Presence + 6 hours"]: [&"Присутствие + 6 часов"],
[&"", &"May function as 5 meals"]: [&"Может заменить 5 приёмов пищи"],
[&"", &"Holds 7 normal-sized items"]: [&"Вмещает 7 обычных предметов"],
[&"", &"Holds 10 normal sized items"]: [&"Вмещает 10 обычных предметов"],
[&"", &"10 nails, hammer, small saw, tongs; starting equipment: 10 nails, tongs, hammer, small saw and drill"]: [&"10 гвоздей, молоток, пила, щипцы; начальный набор: 10 гвоздей, щипцы, молоток, пила и сверло"],
[&"", &"4 days of water\nCharacters begin with a waterskin"]: [&"Воды на 4 дня\nПерсонажи начинают с бурдюком"],
[&"", &"1 day\nCharacters begin with d4 days worth of food"]: [&"На 1 день\nВ начале у персонажей еды на d4 дня"],
