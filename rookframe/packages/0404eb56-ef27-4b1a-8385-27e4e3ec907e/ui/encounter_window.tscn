[node name="Previous" type="Button" parent="Layout/Footer/TrailingSlot/Navigation"]
layout_mode = 1
anchor_right = 0.5
offset_right = -4.0
anchor_bottom = 1.0
custom_minimum_size = Vector2(0, 52)
