[node name="Primary" type="Button" parent="Layout/Footer/TrailingSlot/Navigation"]
layout_mode = 1
anchor_left = 0.5
anchor_right = 1.0
offset_left = 4.0
anchor_bottom = 1.0
custom_minimum_size = Vector2(0, 52)
theme_type_variation = &"RookframePrimaryButton"
text = "Next"


[node name="Poll" type="Timer" parent="."]
wait_time = 0.5
autostart = true
