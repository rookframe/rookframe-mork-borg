[node name="Footer" parent="Layout" instance=ExtResource("footer")]
layout_mode = 2

[node name="LeadingSlot" parent="Layout/Footer" index=0]
visible = false

[node name="TrailingSlot" parent="Layout/Footer" index=1]
size_flags_horizontal = 3

[node name="Navigation" type="Control" parent="Layout/Footer/TrailingSlot"]
layout_mode = 2
