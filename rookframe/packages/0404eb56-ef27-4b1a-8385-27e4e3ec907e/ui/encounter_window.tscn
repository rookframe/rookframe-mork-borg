[node name="Morale" type="Button" parent="Layout/Body/Content/Selected/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(92, 44)
theme_type_variation = &"RookframeSecondaryButton"
text = "Morale"

[node name="Outcome" type="Label" parent="Layout/Body/Content"]
layout_mode = 2
visible = false
theme_type_variation = &"RookframeStatus"
autowrap_mode = 2

[node name="Options" type="VBoxContainer" parent="Layout/Body/Content"]
layout_mode = 2
visible = false
theme_override_constants/separation = 8

[node name="Round" type="HBoxContainer" parent="Layout/Body/Content/Options"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Label" type="Label" parent="Layout/Body/Content/Options/Round"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"RookframeLabel"
text = "Round"

[node name="Value" type="LineEdit" parent="Layout/Body/Content/Options/Round"]
layout_mode = 2
custom_minimum_size = Vector2(72, 44)
