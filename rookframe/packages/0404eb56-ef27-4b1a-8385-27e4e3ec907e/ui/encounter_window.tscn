toggle_mode = true
compact = true

[node name="Monsters" parent="Layout/Body/Content/Sides" instance=ExtResource("button")]
layout_mode = 2
size_flags_horizontal = 3
text = "Monsters"
toggle_mode = true
compact = true

[node name="Roll" parent="Layout/Body/Content/Sides" instance=ExtResource("button")]
