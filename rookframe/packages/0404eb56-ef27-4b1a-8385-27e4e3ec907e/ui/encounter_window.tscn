[node name="Encounter" type="Control"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
script = ExtResource("script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("box")

[node name="TaskState" parent="Layout" instance=ExtResource("state")]
layout_mode = 2
custom_minimum_size = Vector2(0, 0)
state = 0
title = "Loading encounter"

[node name="Body" type="ScrollContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Content" type="VBoxContainer" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
script = ExtResource("box")

[node name="Sides" type="HBoxContainer" parent="Layout/Body/Content"]
layout_mode = 2
script = ExtResource("box")
gap = &"space_1"

[node name="Players" parent="Layout/Body/Content/Sides" instance=ExtResource("button")]
layout_mode = 2
size_flags_horizontal = 3
