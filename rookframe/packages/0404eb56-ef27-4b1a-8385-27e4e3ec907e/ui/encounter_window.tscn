[gd_scene load_steps=7 format=3]
[ext_resource type="Script" path="res://rookframe/packages/0404eb56-ef27-4b1a-8385-27e4e3ec907e/ui/encounter_window.gd" id="script"]
[ext_resource type="Theme" path="res://rookframe/ui/theme/rookframe_theme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://rookframe/ui/icons/dice.svg" id="dice"]
[ext_resource type="Texture2D" path="res://rookframe/ui/icons/person.svg" id="fallback"]
[ext_resource type="PackedScene" path="res://rookframe/ui/components/layout/action_bar.tscn" id="footer"]

[ext_resource type="PackedScene" path="res://rookframe/ui/components/feedback/task_state.tscn" id="state"]

[node name="Encounter" type="Control"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = 8.0
offset_right = -12.0
offset_bottom = -8.0
theme_override_constants/separation = 8

[node name="TaskState" parent="Layout" instance=ExtResource("state")]
layout_mode = 2
custom_minimum_size = Vector2(0, 0)
state = 0
title = "Loading encounter"

[node name="Body" type="ScrollContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
follow_focus = true

[node name="Content" type="VBoxContainer" parent="Layout/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Sides" type="HBoxContainer" parent="Layout/Body/Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Players" type="Button" parent="Layout/Body/Content/Sides"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
theme_type_variation = &"RookframeTabButton"
text = "Players"
toggle_mode = true

[node name="Monsters" type="Button" parent="Layout/Body/Content/Sides"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
size_flags_horizontal = 3
theme_type_variation = &"RookframeTabButton"
text = "Monsters"
toggle_mode = true

[node name="Roll" type="Button" parent="Layout/Body/Content/Sides"]
layout_mode = 2
custom_minimum_size = Vector2(44, 44)
theme_type_variation = &"RookframeQuietButton"
icon = ExtResource("dice")
icon_alignment = 1
theme_override_constants/icon_max_width = 24
expand_icon = true
tooltip_text = "Roll initiative"
accessibility_name = "Roll initiative"

[node name="Empty" type="Label" parent="Layout/Body/Content"]
layout_mode = 2
theme_type_variation = &"RookframeMeta"
text = "Select a Rook and tap swords to add it."
autowrap_mode = 2

[node name="Selected" type="HBoxContainer" parent="Layout/Body/Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Preview" type="Control" parent="Layout/Body/Content/Selected"]
custom_minimum_size = Vector2(52, 64)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2

[node name="Fallback" type="TextureRect" parent="Layout/Body/Content/Selected/Preview"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
texture = ExtResource("fallback")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Identity" type="VBoxContainer" parent="Layout/Body/Content/Selected"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 2

[node name="Name" type="Label" parent="Layout/Body/Content/Selected/Identity"]
layout_mode = 2
theme_type_variation = &"RookframeIdentity"
text_overrun_behavior = 3

[node name="Kind" type="Label" parent="Layout/Body/Content/Selected/Identity"]
layout_mode = 2
theme_type_variation = &"RookframeMeta"
text_overrun_behavior = 3

[node name="Actions" type="VBoxContainer" parent="Layout/Body/Content/Selected"]
layout_mode = 2
custom_minimum_size = Vector2(92, 0)
theme_override_constants/separation = 0

[node name="Reaction" type="Button" parent="Layout/Body/Content/Selected/Actions"]
layout_mode = 2
