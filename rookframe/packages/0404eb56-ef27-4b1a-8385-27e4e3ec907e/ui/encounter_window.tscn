max_length = 4

[node name="Set" type="Button" parent="Layout/Body/Content/Options/Round"]
layout_mode = 2
custom_minimum_size = Vector2(44, 44)
theme_type_variation = &"RookframeQuietButton"
text = "Set"

[node name="End" type="Button" parent="Layout/Body/Content/Options"]
layout_mode = 2
custom_minimum_size = Vector2(0, 44)
